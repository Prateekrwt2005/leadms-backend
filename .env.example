PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/crm_backend
JWT_SECRET=your_super_secret_jwt_key
CLIENT_URL=http://localhost:5000

# Nodemailer setup for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
# Use an App Password (16 characters) here, NOT your regular Gmail password. 
# Setup instructions: https://support.google.com/accounts/answer/185833
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=your_gmail_address@gmail.com
